{
  "name": "@kabegame/plugin-sdk",
  "version": "4.6.0",
  "type": "module",
  "description": "Kabegame JavaScript crawler plugin SDK",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kabegame/kabegame-plugin-sdk.git"
  },
  "homepage": "https://github.com/kabegame/kabegame-plugin-sdk#readme",
  "bugs": "https://github.com/kabegame/kabegame-plugin-sdk/issues",
  "keywords": [
    "kabegame",
    "crawler",
    "plugin",
    "sdk"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./md5": {
      "types": "./dist/md5.d.ts",
      "import": "./dist/md5.js",
      "default": "./dist/md5.js"
    },
    "./i18n": {
      "types": "./dist/i18n.d.ts",
      "import": "./dist/i18n.js",
      "default": "./dist/i18n.js"
    },
    "./misc": {
      "types": "./dist/misc.d.ts",
      "import": "./dist/misc.js",
      "default": "./dist/misc.js"
    },
    "./regex": {
      "types": "./dist/regex.d.ts",
      "import": "./dist/regex.js",
      "default": "./dist/regex.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "default": "./dist/types.js"
    },
    "./url": {
      "types": "./dist/url.d.ts",
      "import": "./dist/url.js",
      "default": "./dist/url.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "kabegame": ">=4.3.0"
  },
  "devDependencies": {
    "@kabegame/types": "^4.5.1",
    "typescript": "^5.4.5"
  }
}
