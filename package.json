{
  "name": "@kabegame/plugin-sdk",
  "version": "4.5.0",
  "type": "module",
  "description": "Kabegame JavaScript crawler plugin SDK",
  "license": "GPL-3.0-only",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./md5": {
      "types": "./dist/md5.d.ts",
      "import": "./dist/md5.js",
      "default": "./dist/md5.js"
    },
    "./misc": {
      "types": "./dist/misc.d.ts",
      "import": "./dist/misc.js",
      "default": "./dist/misc.js"
    },
    "./regex": {
      "types": "./dist/regex.d.ts",
      "import": "./dist/regex.js",
      "default": "./dist/regex.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "default": "./dist/types.js"
    },
    "./url": {
      "types": "./dist/url.d.ts",
      "import": "./dist/url.js",
      "default": "./dist/url.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "engines": {
    "kabegame": ">=4.3.0"
  },
  "dependencies": {
    "@kabegame/types": "file:../kabegame-types"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  }
}
